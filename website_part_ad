    <!-- Video Modal -->
    <div class="video-modal" id="videoModal">
        <div class="video-modal-content" id="modalContent">
            <button class="close-modal" onclick="closeVideo()">&times;</button>
            <video id="modalVideo" class="modal-video" controls>
                <source src="" type="video/mp4">
                <source src="" type="video/quicktime">
            </video>
        </div>
