    <script>
        // Video configuration with your exact filenames
        const videoConfig = {
            1: {
                directUrl: '/videos/Mauro Testimonial.MP4',
                orientation: 'portrait',
                name: 'Mauro',
                format: 'mp4'
            },
            2: {
                directUrl: 'https://storage.googleapis.com/msgsndr/yOkUSQmv7D3J1n6pmgAL/media/686c732dd55cfe6294cd77a4.mp4',
                orientation: 'portrait', 
                name: 'Dan',
                format: 'mp4'
            },
            3: {
                directUrl: '/videos/JaiEditedTestimonial.mp4',
                orientation: 'landscape',
                name: 'Jai',
                format: 'mp4'
            }
        };

        // Play video inline function
        function playVideoInline(videoId) {
            const container = document.querySelector(`[data-video-id="${videoId}"]`);
            const config = videoConfig[videoId];
            
            // Check if inline player already exists
            let inlinePlayer = container.querySelector('.video-player-inline');
            
            if (!inlinePlayer) {
                // Create inline player
                inlinePlayer = document.createElement('div');
                inlinePlayer.className = 'video-player-inline';
                inlinePlayer.innerHTML = `
                    <div class="inline-loading"></div>
                    <video controls>
                        <source src="${config.directUrl}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                    <div class="video-controls-overlay">
                        <button class="video-control-btn" onclick="toggleFullscreen(${videoId})" title="Fullscreen">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                            </svg>
                        </button>
                        <button class="video-control-btn" onclick="closeInlineVideo(${videoId})" title="Close">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                        </button>
                    </div>
                `;
                
                // Insert player at the beginning of container
                container.insertBefore(inlinePlayer, container.firstChild);
                
                // Get video element
                const video = inlinePlayer.querySelector('video');
                
                // Add loading class
                inlinePlayer.classList.add('loading');
                
                // Handle video load
                video.addEventListener('loadeddata', function() {
                    inlinePlayer.classList.remove('loading');
                });
                
                // Handle video end
                video.addEventListener('ended', function() {
                    // Optionally close the video when it ends
                    // closeInlineVideo(videoId);
                });
            }
            
            // Show player and hide thumbnail
            inlinePlayer.classList.add('active');
            container.classList.add('playing');
            
            // Play video
            const video = inlinePlayer.querySelector('video');
            video.play().catch(e => console.log('Autoplay prevented:', e));
        }

        // Close inline video
        function closeInlineVideo(videoId) {
            const container = document.querySelector(`[data-video-id="${videoId}"]`);
            const inlinePlayer = container.querySelector('.video-player-inline');
            const video = inlinePlayer.querySelector('video');
            
            // Pause and reset video
            video.pause();
            video.currentTime = 0;
            
            // Hide player and show thumbnail
            inlinePlayer.classList.remove('active');
            container.classList.remove('playing');
        }

        // Toggle fullscreen
        function toggleFullscreen(videoId) {
            const container = document.querySelector(`[data-video-id="${videoId}"]`);
            const inlinePlayer = container.querySelector('.video-player-inline');
            const video = inlinePlayer.querySelector('video');
            
            if (!document.fullscreenElement) {
                // Enter fullscreen
                if (video.requestFullscreen) {
                    video.requestFullscreen();
                } else if (video.webkitRequestFullscreen) {
                    video.webkitRequestFullscreen();
                } else if (video.msRequestFullscreen) {
                    video.msRequestFullscreen();
                }
            } else {
                // Exit fullscreen
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
            }
        }

        // Play video function (keeping modal as backup)
        function playVideo(videoId) {
            const config = videoConfig[videoId];
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('modalVideo');
            const modalContent = document.getElementById('modalContent');
            
            // Set orientation class
            modalContent.className = `video-modal-content ${config.orientation}`;
            
            // Set video source based on format
            if (config.format === 'mov') {
                video.innerHTML = `
                    <source src="${config.directUrl}" type="video/quicktime">
                    <source src="${config.directUrl}" type="video/mp4">
                    Your browser does not support the video tag.
                `;
            } else {
                video.innerHTML = `
                    <source src="${config.directUrl}" type="video/mp4">
                    Your browser does not support the video tag.
                `;
            }
            
            // Show modal
            modal.classList.add('active');
            
            // Load and try to play
            video.load();
            video.play().catch(e => {
                console.log('Autoplay prevented or format issue:', e);
                // Video will still show with controls even if autoplay fails
            });
        }

        // Close video function
        function closeVideo() {
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('modalVideo');
            
            video.pause();
            video.src = '';
            modal.classList.remove('active');
        }

        // Parallax effect for orbs
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const orbs = document.querySelectorAll('.orb');
            
            orbs.forEach((orb, index) => {
                const speed = 0.5 + (index * 0.1);
                const translateY = scrolled * speed * 0.3;
                orb.style.transform = `translate(0, ${translateY}px) scale(1)`;
            });
        });

        // Cursor Follower Effect
        const cursorFollower = document.querySelector('.cursor-follower');
        const cursorDot = document.querySelector('.cursor-dot');
        let mouseX = 0;
        let mouseY = 0;
        let followerX = 0;
        let followerY = 0;
        let dotX = 0;
        let dotY = 0;

        // Check if device has mouse
        const hasHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (hasHover) {
            // Track mouse position
            document.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
            });

            // Smooth animation loop
            function animateCursor() {
                // Smooth follow for main circle - slower for more elegance
                followerX += (mouseX - followerX) * 0.06;
                followerY += (mouseY - followerY) * 0.06;
                cursorFollower.style.left = followerX + 'px';
                cursorFollower.style.top = followerY + 'px';

                // Faster follow for dot but still smooth
                dotX += (mouseX - dotX) * 0.2;
                dotY += (mouseY - dotY) * 0.2;
                cursorDot.style.left = dotX + 'px';
                cursorDot.style.top = dotY + 'px';

                requestAnimationFrame(animateCursor);
            }
            animateCursor();

            // Add hover effects
            const interactiveElements = document.querySelectorAll('a, button, .service-cta, .btn-primary, .btn-secondary, .video-container, .start-quiz-btn, .demo-btn, input, textarea');
            const serviceCards = document.querySelectorAll('.service-tier');
            
            interactiveElements.forEach(el => {
                el.addEventListener('mouseenter', () => {
                    document.body.classList.add('cursor-hover');
                });
                
                el.addEventListener('mouseleave', () => {
                    document.body.classList.remove('cursor-hover');
                });
            });

            // Special effect for service cards
            serviceCards.forEach(card => {
                card.addEventListener('mouseenter', () => {
                    document.body.classList.add('cursor-service');
                });
                
                card.addEventListener('mouseleave', () => {
                    document.body.classList.remove('cursor-service');
                });
            });

            // Special effect for gradient text
            const gradientTexts = document.querySelectorAll('.hero h1, .tagline, .highlight, .founder-info em');
            gradientTexts.forEach(text => {
                text.addEventListener('mouseenter', () => {
                    document.body.classList.add('cursor-gradient');
                });
                
                text.addEventListener('mouseleave', () => {
                    document.body.classList.remove('cursor-gradient');
                });
            });

            // Hide cursor when leaving window
            document.addEventListener('mouseout', (e) => {
                if (!e.relatedTarget) {
                    cursorFollower.style.opacity = '0';
                    cursorDot.style.opacity = '0';
                }
            });

            document.addEventListener('mouseover', () => {
                cursorFollower.style.opacity = '1';
                cursorDot.style.opacity = '1';
            });

            // Add click effect
            document.addEventListener('mousedown', () => {
                cursorFollower.classList.add('clicking');
                cursorDot.classList.add('clicking');
            });

            document.addEventListener('mouseup', () => {
                cursorFollower.classList.remove('clicking');
                cursorDot.classList.remove('clicking');
            });
        }

        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-in');
                }
            });
        }, observerOptions);

        // Apply to all animate-on-scroll elements
        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            observer.observe(el);
        });

        // Also observe individual cards
        document.querySelectorAll('.trust-item, .service-tier, .psychology-card, .result-card, .video-testimonial-card').forEach(el => {
            observer.observe(el);
        });

        // Add hover effects for what-we-do service cards
        document.querySelectorAll('.service-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-3px)';
                this.style.boxShadow = '0 10px 25px rgba(0,0,0,0.08)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
                this.style.boxShadow = 'none';
            });
        });

        // Quiz functionality
        document.querySelectorAll('.start-quiz-btn, .video-preview').forEach(element => {
            element.addEventListener('click', function() {
                // Redirect to contact section for booking
                window.location.href = '#contact';
            });
        });

        // Demo functionality
        document.querySelector('.demo-btn:last-child').addEventListener('click', function(e) {
            if (!this.href.includes('tel:')) {
                e.preventDefault();
                alert('Video demo would play here');
            }
        });

        // Video Testimonials Functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Update click handlers for inline playback
            document.querySelectorAll('.video-container[data-video-id]').forEach(container => {
                const newContainer = container.cloneNode(true);
                container.parentNode.replaceChild(newContainer, container);
                
                newContainer.addEventListener('click', function(e) {
                    // Don't trigger if clicking on controls
                    if (e.target.closest('.video-controls-overlay')) return;
                    
                    const videoId = this.getAttribute('data-video-id');
                    
                    // Check if video is already playing
                    if (!this.classList.contains('playing')) {
                        playVideoInline(videoId);
                    }
                });
            });
            
            // Keep modal close functionality
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeVideo();
                }
            });
            
            document.getElementById('videoModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeVideo();
                }
            });
            
            // Read More functionality for testimonials
            const readMoreBtns = document.querySelectorAll('.read-more-btn');
            
            readMoreBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const testimonialId = this.getAttribute('data-testimonial');
                    const fullTestimonial = document.getElementById(`testimonial-${testimonialId}`);
                    const isExpanded = this.classList.contains('expanded');
                    
                    if (isExpanded) {
                        // Collapse
                        fullTestimonial.classList.remove('expanded');
                        this.classList.remove('expanded');
                        this.innerHTML = `
                            Read Full Story
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 12L12 8L8 4" stroke="currentColor" stroke-width="2" fill="none"/>
                            </svg>
                        `;
                    } else {
                        // Expand
                        fullTestimonial.classList.add('expanded');
                        this.classList.add('expanded');
                        this.innerHTML = `
                            Show Less
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 12L12 8L8 4" stroke="currentColor" stroke-width="2" fill="none"/>
                            </svg>
                        `;
                    }
                });
            });
        });

        // Number counter animation
        function animateValue(obj, start, end, duration) {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerHTML = Math.floor(progress * (end - start) + start);
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        // Dynamic Scrollbar Gradient
        function updateScrollbarGradient() {
            const scrollPercentage = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
            
            // Smooth color transition based on scroll position
            // Color journey through the page:
            // Top (Hero) - Cool blues (#2EA6D4, #79C5C7, #1B75BB)
            // Early sections - Transition to teals (#79C5C7, #00A79D)
            // Middle (Services) - Warm colors (#FF9A56, #B565A7)
            // Bottom (Footer) - Return to brand blues
            
            let gradient;
            const position = scrollPercentage / 100;
            
            // Define color stops for smooth transitions
            if (position < 0.25) {
                // Top quarter - Cool blues
                const localPos = position * 4;
                gradient = `linear-gradient(180deg, 
                    #2EA6D4 0%, 
                    #79C5C7 ${50 + localPos * 25}%, 
                    #1B75BB 100%)`;
            } else if (position < 0.5) {
                // Second quarter - Transition to teals
                const localPos = (position - 0.25) * 4;
                gradient = `linear-gradient(180deg, 
                    #79C5C7 0%, 
                    #00A79D ${30 + localPos * 20}%, 
                    #2EA6D4 100%)`;
            } else if (position < 0.75) {
                // Third quarter - Warm transition
                const localPos = (position - 0.5) * 4;
                gradient = `linear-gradient(180deg, 
                    #00A79D 0%, 
                    #FF9A56 ${40 + localPos * 20}%, 
                    #B565A7 100%)`;
            } else {
                // Final quarter - Return to brand blues
                const localPos = (position - 0.75) * 4;
                gradient = `linear-gradient(180deg, 
                    #B565A7 0%, 
                    #1B75BB ${30 + localPos * 30}%, 
                    #2EA6D4 100%)`;
            }
            
            // Apply gradient with smooth transition
            const styleId = 'dynamic-scrollbar-style';
            let styleElement = document.getElementById(styleId);
            
            if (!styleElement) {
                styleElement = document.createElement('style');
                styleElement.id = styleId;
                document.head.appendChild(styleElement);
            }
            
            // Add subtle glow color that matches current gradient position
            const glowColor = position < 0.25 ? 'rgba(46, 166, 212, 0.5)' :
                             position < 0.5 ? 'rgba(121, 197, 199, 0.5)' :
                             position < 0.75 ? 'rgba(255, 154, 86, 0.5)' :
                             'rgba(181, 101, 167, 0.5)';
            
            styleElement.textContent = `
                ::-webkit-scrollbar-thumb {
                    background: ${gradient};
                    border-radius: 10px;
                    border: 2px solid #f1f5f9;
                    transition: background 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                }
                
                ::-webkit-scrollbar-thumb:hover {
                    background: ${gradient};
                    border-color: #e5e7eb;
                    box-shadow: 0 0 20px ${glowColor};
                    filter: brightness(1.15) saturate(1.2);
                    transition: all 0.3s ease;
                }
                
                ::-webkit-scrollbar-thumb:active {
                    filter: brightness(0.9);
                }
                
                /* Firefox fallback - single color based on position */
                * {
                    scrollbar-width: thin;
                    scrollbar-color: ${
                        position < 0.25 ? '#2EA6D4' :
                        position < 0.5 ? '#79C5C7' :
                        position < 0.75 ? '#FF9A56' :
                        '#B565A7'
                    } #f1f5f9;
                }
            `;
        }

        // Initialize scrollbar gradient
        updateScrollbarGradient();

        // Update on scroll with throttling for performance
        let scrollTimeout;
        window.addEventListener('scroll', () => {
            if (scrollTimeout) {
                window.cancelAnimationFrame(scrollTimeout);
            }
            scrollTimeout = window.requestAnimationFrame(() => {
                updateScrollbarGradient();
            });
        });

        // Also update on window resize
        window.addEventListener('resize', () => {
            updateScrollbarGradient();
        });

        // Animate result metrics when they come into view
        const metricObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !entry.target.animated) {
                    entry.target.animated = true;
                    const value = entry.target.innerText;
                    if (value.includes('%')) {
                        animateValue(entry.target, 0, parseInt(value), 3000);
                        setTimeout(() => {
                            entry.target.innerHTML += '%';
                        }, 3000);
                    } else if (value.includes('-')) {
                        const parts = value.split('-');
                        animateValue(entry.target, 0, parseInt(parts[0]), 3000);
                        setTimeout(() => {
                            entry.target.innerHTML += '-' + parts[1];
                        }, 3000);
                    } else if (value.includes('x')) {
                        animateValue(entry.target, 0, parseInt(value), 3000);
                        setTimeout(() => {
                            entry.target.innerHTML += 'x';
                        }, 3000);
                    } else {
                        animateValue(entry.target, 0, parseInt(value), 3000);
                    }
                }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.result-metric').forEach(el => {
            metricObserver.observe(el);
        });
    </script>
